# ==========================================================
# Genius Agenda AI - exemplo de variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.
# Estes valores são lidos pelo docker-compose.example.yml.
# ==========================================================

# ---- Fuso horário (calendário e lembretes) ----
TZ=America/Recife
GENERIC_TIMEZONE=America/Recife

# ---- n8n ----
N8N_PORT=5678
# Gere com: openssl rand -hex 24  (protege as credenciais salvas no n8n)
N8N_ENCRYPTION_KEY=troque_por_um_valor_aleatorio

# ---- WAHA (WhatsApp) ----
WAHA_PORT=3000
# Chave enviada no header X-Api-Key (use a mesma na credencial Header Auth do n8n)
WAHA_API_KEY=troque_por_uma_chave_forte
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troque_esta_senha
# Para onde o WAHA envia as mensagens recebidas (path do nó Webhook WAHA)
WHATSAPP_HOOK_URL=http://n8n:5678/webhook/genius-agenda
WHATSAPP_HOOK_EVENTS=message

# ==========================================================
# Segredos que NÃO ficam em arquivo: são cadastrados como
# Credenciais dentro do n8n (guardadas criptografadas):
#   - Google Calendar OAuth2  -> Client ID / Client Secret (Google Cloud)
#   - Google Gemini (PaLM) API -> chave do Google AI Studio
#   - Header Auth (WAHA)      -> Name: X-Api-Key | Value: WAHA_API_KEY
#
# Valores a editar DENTRO dos nós de código (ver README):
#   - ALLOWED   (workflow 01, nó "Filtrar e deduplicar")
#   - OWNER     (workflow 02, nó "Calcular lembretes devidos")
#   - OFFSETS   (workflow 02) minutos antes do evento: [1440, 60, 15]
#   - session   (nós HTTP) nome da sessão do WAHA (padrão: default)
# ==========================================================
